{
    "name": "Local VLC 2",
    "version": "19",
    "slug": "local_vlc_2",
    "description": "Play VLC player",
    "url": "https://github.com/rodripf/hassio-local-vlc2",    
    "arch": ["armhf", "armv7", "aarch64", "amd64", "i386"],
    "startup": "application",
    "boot": "auto",
    "options": 
    "audio": true,
    "ports":{
        "9893/tcp":9893,
        "4213/tcp":4213
    },
    "webui": "http://[HOST]:[PORT:9893]/",
    "map": ["share:ro", "ssl"]
  }
